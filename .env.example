# Promise Keeper Environment Configuration Example
# Synthetic development profile (no real credentials needed)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/promise_keeper_dev

# S3 / MinIO Private Storage configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=promise-keeper-evidence
STORAGE_REGION=local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Session authentication secret (minimum 32 characters)
SESSION_SECRET=dev-synthetic-session-secret-min-32-chars-long!

# Processing Mode: synthetic | hosted | self_hosted
PROCESSING_MODE=synthetic

# Optional Hosted Gemma Model Configuration (if PROCESSING_MODE=hosted)
# GEMMA_API_KEY=
