{
  "name": "promise-keeper-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "One place to remember what brands promised you, notice what changed, and act with the evidence.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "tsc --build",
    "format": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "check": "python scripts/check_repo.py && python -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
